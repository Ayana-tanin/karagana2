# Telegram (для заказов и заявок на карагану)
# Откуда берутся: создайте бота в @BotFather, получите токен; Chat ID — через @userinfobot или getUpdates.
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Пример заполнения для теста:
# TELEGRAM_BOT_TOKEN=7123456789:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TELEGRAM_CHAT_ID=123456789

# В комментарии к заявке на карагану пользователь указывает:
# — объём сырья (кг);
# — район или адрес, где можно собрать/принять карагану;
# — желаемые сроки.
